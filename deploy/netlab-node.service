[Unit]
Description=Netlab node executor
After=network-online.target containerd.service libvirtd.service ovn-controller.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/netlab-node
Restart=on-failure
RestartSec=3
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
